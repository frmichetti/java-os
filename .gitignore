# Build artifacts
/target/
**/target/

# Disk images gerados pelo xtask (boot/imagem do Limine)
*.img
*.iso
/boot/dist/

# Binários/ferramentas do Limine baixados pelo provisionamento
/boot/limine/
/third_party/limine/

# Código-fonte de bibliotecas de terceiros vendorizadas localmente (ex.:
# newlib, change `libc-minimal-port`) — baixado pelo provisionamento, mesmo
# tratamento do Limine acima.
/vendor/

# Firmware OVMF baixado localmente (quando não provisionado via sistema)
*.fd

# Editor/IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
