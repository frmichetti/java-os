#!/usr/bin/env bash
# Wrapper fino sobre o G++ do host — mesmo racional de x86_64-elf-gcc (host e
# alvo são ambos x86_64, nenhum cross-compilador dedicado é necessário) — ver
# openspec/changes/archive/*-cxx-minimal-runtime/design.md.
#
# SSE continua desabilitado aqui de propósito, mesmo depois da change
# kernel-fpu-context-switch já ter ensinado o kernel a salvar/restaurar
# FPU/XMM por thread (o que tornaria SSE tecnicamente seguro de usar): esta
# change entrega só o runtime de linguagem C++ (new/delete, despacho
# virtual), não decide reabilitar ponto flutuante em todo o toolchain C/C++
# — isso fica rastreado separadamente em ROADMAP.md ("Reconstruir
# libm/conversão float da libc agora que SSE está disponível"), já que
# reabilitar aqui também reabriria a build do newlib (libm excluída
# deliberadamente por libc-minimal-port). Mesmas flags de sem-SSE do wrapper
# de C, para o C++ compilado aqui permanecer ABI-compatível com ele.
#
# -fno-exceptions -fno-rtti -fno-use-cxa-atexit: achado confirmado
# empiricamente (ver design.md) — um .cpp com herança/virtual compila e
# linka só precisando de operator new/delete (fornecidos por
# userland_c/cxx_runtime.cpp), sem precisar de nenhuma infraestrutura de
# exceções, RTTI ou __cxa_atexit/__dso_handle.
exec g++ \
  -ffreestanding \
  -nostdlib \
  -fno-pie -no-pie \
  -fno-stack-protector \
  -mno-sse -mno-sse2 -mno-sse3 -mno-mmx -mno-80387 \
  -fno-exceptions -fno-rtti -fno-use-cxa-atexit \
  "$@"
