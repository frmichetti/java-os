#!/usr/bin/env bash
# Wrapper fino sobre o G++ do host — mesmo racional de x86_64-elf-gcc (host e
# alvo são ambos x86_64, nenhum cross-compilador dedicado é necessário) — ver
# openspec/changes/archive/*-cxx-minimal-runtime/design.md.
#
# SSE/SSE2/SSE3/MMX/x87 HABILITADOS (mudança da change `libc-float-math`):
# até então este wrapper forçava as mesmas flags `-mno-sse*` de
# `x86_64-elf-gcc`, rastreadas desde a própria `cxx-minimal-runtime` como
# pendentes em ROADMAP.md ("Reconstruir libm/conversão float da libc agora
# que SSE está disponível"). `kernel-fpu-context-switch` já ensinou o kernel
# a salvar/restaurar FPU/XMM por thread, e `libc-float-math` reconstruiu o
# newlib vendorizado (libm + conversão float) sobre isso — removidas aqui as
# mesmas flags `-mno-*` do wrapper de C, pelo mesmo motivo e sem adicionar
# nenhuma flag positiva (ver `x86_64-elf-gcc` e design.md de
# `libc-float-math`).
#
# -fno-exceptions -fno-rtti -fno-use-cxa-atexit: achado confirmado
# empiricamente (ver design.md) — um .cpp com herança/virtual compila e
# linka só precisando de operator new/delete (fornecidos por
# userland_c/cxx_runtime.cpp), sem precisar de nenhuma infraestrutura de
# exceções, RTTI ou __cxa_atexit/__dso_handle.
exec g++ \
  -ffreestanding \
  -nostdlib \
  -fno-pie -no-pie \
  -fno-stack-protector \
  -fno-exceptions -fno-rtti -fno-use-cxa-atexit \
  "$@"
